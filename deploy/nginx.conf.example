# Example nginx server block for the 911 Training Simulator on a VPS.
# Replace example.com with your domain. Use certbot to issue TLS certs.
#
# The mic + Web Speech API require HTTPS in Chrome/Edge/Safari — do NOT
# serve this from plain http in production.

upstream explorers911 {
    server 127.0.0.1:8787;
}

server {
    listen 80;
    listen [::]:80;
    server_name example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;

    # Hardening
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "microphone=(self)" always;

    client_max_body_size 1m;

    location / {
        proxy_pass         http://explorers911;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # SSE endpoint for the /admin projector view — disable buffering so
    # events reach the browser in real time, and allow a long read timeout.
    location = /api/admin/stream {
        proxy_pass            http://explorers911;
        proxy_http_version    1.1;
        proxy_set_header      Host              $host;
        proxy_set_header      X-Real-IP         $remote_addr;
        proxy_set_header      X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header      X-Forwarded-Proto $scheme;
        proxy_set_header      Connection        "";
        proxy_buffering       off;
        proxy_cache           off;
        proxy_read_timeout    1h;
        chunked_transfer_encoding off;
    }
}
