# No API key needed — the server uses your Claude Max subscription via
# the Claude Agent SDK. Authenticate once by running:
#
#   claude /login
#
# under the same OS user that runs the server (see README).

# Optional: pin a model (defaults to claude-sonnet-4-5)
# CLAUDE_MODEL=claude-sonnet-4-5

# Optional: server port (defaults to 8787)
# PORT=8787
